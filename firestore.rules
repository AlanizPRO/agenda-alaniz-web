rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function esLector(uid) {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/users/$(uid)).data.get('lectores', []);
    }

    // Cliente con portal de reservas: lo da de alta el dueño en clientesPortal/{correo}
    function correo() {
      return request.auth.token.email.lower();
    }
    function esCliente(uid) {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/clientesPortal/$(correo()))
        && get(/databases/$(database)/documents/clientesPortal/$(correo())).data.owner == uid;
    }

    match /users/{uid} {
      allow read: if esDueno(uid) || esLector(uid);
      allow write: if esDueno(uid);

      match /trabajos/{id} {
        allow read: if esDueno(uid) || esLector(uid);
        allow write: if esDueno(uid);
      }

      // Proformas: las hace el dueño o la cuenta de ventas; solo el dueño las cambia o borra
      match /proformas/{id} {
        allow read, create: if esDueno(uid) || esLector(uid);
        allow update, delete: if esDueno(uid);
      }
      // Borradores de proforma: los ven y terminan el dueño y la cuenta de ventas
      match /borradores/{id} {
        allow read, write: if esDueno(uid) || esLector(uid);
      }
      // Número consecutivo de proformas: solo puede subir de uno en uno
      match /contadores/{id} {
        allow read: if esDueno(uid) || esLector(uid);
        allow create: if (esDueno(uid) || esLector(uid)) && request.resource.data.ultimo == 1;
        allow update: if (esDueno(uid) || esLector(uid))
          && request.resource.data.ultimo == resource.data.ultimo + 1;
      }

      // Teléfonos que reciben avisos: el dueño, o un lector con su propio correo
      match /tokens/{id} {
        allow read: if false; // solo lo lee la función
        allow create, update: if esDueno(uid)
          || (esLector(uid) && request.resource.data.email == request.auth.token.email);
        allow delete: if esDueno(uid)
          || (esLector(uid) && resource.data.email == request.auth.token.email);
      }

      // Gastos y capturas de pago: privados, solo el dueño
      match /gastos/{id} {
        allow read, write: if esDueno(uid);
      }
      match /comprobantes/{id} {
        allow read, write: if esDueno(uid);
      }
      // Días ocupados (sin detalles): solo "tentativo" o "confirmado". Los ven los clientes del portal.
      match /ocupados/{fecha} {
        allow read: if esDueno(uid) || esLector(uid) || esCliente(uid);
        allow write: if esDueno(uid);
      }
      // Reservas que piden los clientes. Cada cliente ve y toca solo las suyas.
      match /reservas/{id} {
        allow read: if esDueno(uid) || esLector(uid)
          || (esCliente(uid) && resource.data.clienteEmail == correo());
        allow create: if esDueno(uid)
          || (esCliente(uid)
          && request.resource.data.clienteEmail == correo()
          && request.resource.data.estado == "pendiente");
        allow update: if esDueno(uid)
          || (esCliente(uid) && resource.data.clienteEmail == correo()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["comprobante", "comprobanteFecha"]));
        allow delete: if esDueno(uid)
          || (esCliente(uid) && resource.data.clienteEmail == correo() && resource.data.estado == "pendiente");
      }
      // Depósitos LAFISE que lee el programa de Gmail: privados, solo el dueño
      match /depositos/{id} {
        allow read, write: if esDueno(uid);
      }
    }

    // Clientes del portal de reservas: el cliente lee el suyo; el dueño los da de alta
    match /clientesPortal/{email} {
      allow read: if request.auth != null && (correo() == email || resource.data.owner == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Invitaciones: el invitado busca aquí de quién son los datos que puede ver
    match /accesos/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
